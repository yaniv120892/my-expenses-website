# --- Database (Prisma) ---
# DATABASE_URL is the endpoint the app runs on — on a hosted deployment the
# pooled one, with ?pgbouncer=true (and connection_limit=1 on serverless).
# DIRECT_URL is the direct endpoint, for migrations, the seed, and Mastra.
DATABASE_URL=
DIRECT_URL=
# Optional override for Mastra's memory store; defaults to DIRECT_URL.
MASTRA_DB_URL=
# Key for prisma-field-encryption (k1.aesgcm256.<base64>); generate with cloak.
PRISMA_FIELD_ENCRYPTION_KEY=

# --- Auth & sessions ---
JWT_SECRET=
REDIS_URL=
REDIS_TOKEN=
# Bearer secret Vercel sends to cron routes; scheduled jobs 401 without it.
CRON_SECRET=

# --- Site ---
# Required on production; leave unset on previews, which derive the origin from
# VERCEL_BRANCH_URL so callbacks address the preview rather than production.
WEBSITE_URL=
LOG_LEVEL=info

# --- AI ---
# chatgpt (default) | gemini
AI_PROVIDER=chatgpt
OPENAI_API_KEY=
GEMINI_API_KEY=
# Model ids default to a current model; set these only to move off one Google or
# OpenAI has retired, which the API announces in the 404 it starts returning.
GEMINI_MODEL=
OPENAI_MODEL=
# Chat assistant model; ASSISTANT_MODEL_URL overrides the OpenAI base URL
# (the e2e harness points it at a mock server).
ASSISTANT_MODEL_ID=
ASSISTANT_MODEL_URL=
# FastText categorizer sibling service (POST /predict).
EXPENSE_CATEGORIZER_BASE_URL=

# --- Excel extraction sibling service ---
EXCEL_EXTRACTION_AGENT_URL=
EXCEL_EXTRACTION_AGENT_WEBHOOK_SECRET=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Must match the secret_token registered with setWebhook.
TELEGRAM_WEBHOOK_SECRET=
TRANSACTION_CREATED_NOTIFIER_TYPE=telegram
# Empty turns 5xx alerting off entirely. See README "Alerting (Telegram)".
TELEGRAM_ALERT_CHAT_ID=

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Imports bucket (upload + extraction source) ---
IMPORTS_S3_BUCKET=
IMPORTS_S3_REGION=
IMPORTS_S3_ACCESS_KEY_ID=
IMPORTS_S3_SECRET_ACCESS_KEY=

# --- Transaction attachments bucket ---
TRANSACTION_ATTACHMENT_S3_BUCKET_NAME=
TRANSACTION_ATTACHMENT_S3_REGION=
TRANSACTION_ATTACHMENT_S3_ACCESS_KEY_ID=
TRANSACTION_ATTACHMENT_S3_SECRET_ACCESS_KEY=

# --- Backups ---
# aws (default) | google
BACKUP_STORAGE_PROVIDER_TYPE=aws
BACKUP_S3_BUCKET_NAME=
BACKUP_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=

# --- Observability ---
NEXT_PUBLIC_SHOW_REACT_QUERY_DEVTOOLS=false
# Better Stack log ingest. Both unset disables shipping entirely; only warn
# and above is ever sent, to stay inside the free tier.
BETTERSTACK_SOURCE_URL=
BETTERSTACK_SOURCE_TOKEN=
# Better Stack heartbeat URLs, one per cron in vercel.json, pinged after a
# successful run. Unset = that heartbeat is off; the cron itself is unaffected.
BETTERSTACK_HEARTBEAT_SCHEDULED_TRANSACTIONS_PROCESS=
BETTERSTACK_HEARTBEAT_SUMMARY_TODAY=
BETTERSTACK_HEARTBEAT_BACKUP_TRANSACTIONS=
BETTERSTACK_HEARTBEAT_SUBSCRIPTIONS_DETECT=
BETTERSTACK_HEARTBEAT_SUBSCRIPTIONS_AUDIT_NOTIFY=
BETTERSTACK_HEARTBEAT_REPORTS_MONTHLY=
# Sentry error tracking. All four are optional: with no DSN the SDK is inert,
# and without the auth token the build skips source-map upload.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
