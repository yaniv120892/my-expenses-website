# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
test-results/
playwright-report/
.env.local

# proof-of-work screenshots: published from the proof-of-work-assets branch,
# never committed alongside the change they illustrate
/proof-of-work/

# agent scratch/design docs: knowledge belongs in CLAUDE.md, not checked-in plans
/.superpowers/
/docs/superpowers/

# claude code worktrees: agent scratch, never part of the repo
/.claude/worktrees/
