{
  "name": "my-expenses",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:local": "bash scripts/dev-local.sh",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:types": "vitest run --typecheck.only",
    "db:migrate": "prisma migrate deploy",
    "test:e2e:api": "tsx test/e2e-api/run.ts",
    "statements:import": "tsx scripts/import-statements.ts",
    "test:e2e:ui": "playwright test",
    "postinstall": "prisma generate",
    "prepare": "husky",
    "categories:compare": "LOG_LEVEL=error tsx scripts/compare-category-suggesters.ts",
    "statements:due": "tsx scripts/statements-due.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@47ng/cloak": "^1.2.0",
    "@ai-sdk/gateway": "^4.0.125",
    "@ai-sdk/typesafe-ai": "^3.0.26",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@google/generative-ai": "^0.24.1",
    "@mastra/core": "^1.79.0",
    "@mastra/memory": "^1.39.0",
    "@mastra/pg": "^1.32.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.4.0",
    "@mui/material-nextjs": "^9.5.0",
    "@mui/system": "^9.4.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/nextjs": "^11.9.0",
    "@tanstack/react-query": "^5.104.5",
    "@upstash/redis": "^1.34.9",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@yaniv120892/my-ui": "github:yaniv120892/my-ui#v0.1.1",
    "ai": "^7.0.152",
    "axios": "^1.9.0",
    "bcryptjs": "^3.0.2",
    "content-disposition": "^3.0.0",
    "csv-parse": "^7.0.3",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.6.0",
    "googleapis": "^187.0.0",
    "jose": "^6.2.13",
    "json2csv": "^6.0.0-alpha.2",
    "next": "16.4.3",
    "node-telegram-bot-api": "^2.1.0",
    "nodemailer": "^10.2.1",
    "openai": "^6.49.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.1.4",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/json2csv": "^5.0.7",
    "@types/node": "^22",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "eslint": "^10",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "prisma": {
      "mysql2": "^3.22.0"
    }
  }
