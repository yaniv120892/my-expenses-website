{
  "name": "my-expenses",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy",
    "test:e2e:api": "tsx test/e2e-api/run.ts",
    "test:e2e:ui": "playwright test",
    "postinstall": "prisma generate",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@google/generative-ai": "^0.21.0",
    "@mastra/core": "^1.57.0",
    "@mastra/memory": "^1.26.0",
    "@mastra/pg": "^1.19.0",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "@mui/material-nextjs": "^7.3.9",
    "@mui/system": "^7.3.9",
    "@prisma/client": "^6.9.0",
    "@prisma/extension-accelerate": "^1.3.0",
    "@sentry/nextjs": "^9.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-query-devtools": "^5.0.0",
    "@upstash/redis": "^1.34.9",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "axios": "^1.9.0",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "fuse.js": "^7.0.0",
    "googleapis": "^148.0.0",
    "jose": "^6.0.0",
    "json2csv": "^6.0.0-alpha.2",
    "next": "15.3.8",
    "node-telegram-bot-api": "^0.66.0",
    "nodemailer": "^7.0.3",
    "openai": "^4.82.0",
    "pg": "^8.16.0",
    "pino": "^9.6.0",
    "prisma-field-encryption": "^1.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.56.4",
    "recharts": "^2.15.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.1",
    "@types/json2csv": "^5.0.7",
    "@types/node": "^22",
    "@types/node-telegram-bot-api": "^0.64.7",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.2",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.3.3",
    "prisma": "^6.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.10"
  }
}
