{
  "name": "my-expenses",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:local": "bash scripts/dev-local.sh",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:types": "vitest run --typecheck.only",
    "db:migrate": "prisma migrate deploy",
    "test:e2e:api": "tsx test/e2e-api/run.ts",
    "statements:import": "tsx scripts/import-statements.ts",
    "test:e2e:ui": "playwright test",
    "postinstall": "prisma generate",
    "prepare": "husky",
    "categories:compare": "LOG_LEVEL=error tsx scripts/compare-category-suggesters.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.87",
    "@ai-sdk/typesafe-ai": "^3.0.4",
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@google/generative-ai": "^0.24.1",
    "@mastra/core": "^1.57.0",
    "@mastra/memory": "^1.26.0",
    "@mastra/pg": "^1.19.0",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "@mui/material-nextjs": "^7.3.9",
    "@mui/system": "^7.3.9",
    "@prisma/client": "^7.10.0",
    "@sentry/nextjs": "^10.70.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-query-devtools": "^5.0.0",
    "@upstash/redis": "^1.34.9",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.107",
    "axios": "^1.9.0",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "googleapis": "^181.0.0",
    "jose": "^6.0.0",
    "json2csv": "^6.0.0-alpha.2",
    "next": "15.5.24",
    "node-telegram-bot-api": "^2.1.0",
    "nodemailer": "^10.0.10",
    "openai": "^4.82.0",
    "pg": "^8.16.0",
    "pino": "^10.3.1",
    "prisma-field-encryption": "^1.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.56.4",
    "recharts": "^2.15.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/json2csv": "^5.0.7",
    "@types/node": "^22",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.24",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.3.3",
    "prisma": "^6.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.10"
  }
}
