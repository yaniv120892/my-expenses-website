datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  APPROVED
  PENDING_APPROVAL
}

enum NotificationProvider {
  TELEGRAM
}

enum ScheduleType {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REMATCHING
  MERGED
}

enum ImportFileType {
  VISA_CREDIT
  MASTERCARD_CREDIT
  AMERICAN_EXPRESS_CREDIT
}

enum ImportBankSourceType {
  NON_BANK_CREDIT
  BANK_CREDIT
}

enum SubscriptionStatus {
  DETECTED
  CONFIRMED
  DISMISSED
}

enum SubscriptionFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum ImportedTransactionStatus {
  PENDING
  APPROVED
  MERGED
  IGNORED
}

enum ExchangeRateSource {
  STATEMENT
  BANK_OF_ISRAEL
  MANUAL
}

enum HouseholdRole {
  OWNER
  EDITOR
  VIEWER
}

enum TransactionFileStatus {
  ACTIVE
  MARKED_FOR_DELETION
  DELETED
}

model Household {
  id                    String                 @id @default(uuid()) @db.Uuid
  createdAt             DateTime               @default(now())
  members               User[]
  invites               Invite[]
  transactions          Transaction[]
  imports               Import[]
  importedTransactions  ImportedTransaction[]
  scheduledTransactions ScheduledTransaction[]
  categoryMappings      UserCategoryMapping[]
  autoApproveRules      AutoApproveRule[]
  detectedSubscriptions DetectedSubscription[]
  activities            HouseholdActivity[]
}

model Invite {
  id          String        @id @default(uuid()) @db.Uuid
  householdId String        @db.Uuid
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  code        String        @unique
  role        HouseholdRole @default(EDITOR)
  createdById String        @db.Uuid
  createdBy   User          @relation("InvitesCreated", fields: [createdById], references: [id])
  expiresAt   DateTime
  usedById    String?       @db.Uuid
  usedBy      User?         @relation("InvitesUsed", fields: [usedById], references: [id])
  usedAt      DateTime?
  revokedAt   DateTime?
  createdAt   DateTime      @default(now())

  @@index([householdId])
}

model User {
  id                           String                      @id @default(uuid()) @db.Uuid
  username                     String                      @unique
  email                        String                      @unique
  password                     String
  verified                     Boolean                     @default(false)
  householdId                  String                      @db.Uuid
  household                    Household                   @relation(fields: [householdId], references: [id])
  householdRole                HouseholdRole
  tokenVersion                 Int                         @default(0)
  invitesCreated               Invite[]                    @relation("InvitesCreated")
  invitesUsed                  Invite[]                    @relation("InvitesUsed")
  transactions                 Transaction[]
  scheduledTransactions        ScheduledTransaction[]
  userNotification             UserNotificationPreference?
  userNotificationProviders    UserNotificationProvider[]
  imports                      Import[]
  importedTransactions         ImportedTransaction[]
  autoApproveRules             AutoApproveRule[]
  categoryMappings             UserCategoryMapping[]
  detectedSubscriptions        DetectedSubscription[]
  announcementAcks             AnnouncementAck[]
  apiTokens                    ApiToken[]
  transactionsCreated          Transaction[]               @relation("TransactionCreatedBy")
  transactionsUpdated          Transaction[]               @relation("TransactionUpdatedBy")
  importsCreated               Import[]                    @relation("ImportCreatedBy")
  importsUpdated               Import[]                    @relation("ImportUpdatedBy")
  importedTransactionsCreated  ImportedTransaction[]       @relation("ImportedTransactionCreatedBy")
  importedTransactionsUpdated  ImportedTransaction[]       @relation("ImportedTransactionUpdatedBy")
  scheduledTransactionsCreated ScheduledTransaction[]      @relation("ScheduledTransactionCreatedBy")
  scheduledTransactionsUpdated ScheduledTransaction[]      @relation("ScheduledTransactionUpdatedBy")
  userCategoryMappingsCreated  UserCategoryMapping[]       @relation("UserCategoryMappingCreatedBy")
  userCategoryMappingsUpdated  UserCategoryMapping[]       @relation("UserCategoryMappingUpdatedBy")
  autoApproveRulesCreated      AutoApproveRule[]           @relation("AutoApproveRuleCreatedBy")
  autoApproveRulesUpdated      AutoApproveRule[]           @relation("AutoApproveRuleUpdatedBy")
  detectedSubscriptionsCreated DetectedSubscription[]      @relation("DetectedSubscriptionCreatedBy")
  detectedSubscriptionsUpdated DetectedSubscription[]      @relation("DetectedSubscriptionUpdatedBy")
  householdActivities          HouseholdActivity[]

  @@index([householdId])
}

// Which in-app announcements a user has acknowledged. announcementId is a
// string chosen in src/shared/announcements.ts rather than a foreign key, so
// retiring an announcement leaves a harmless orphan row instead of breaking.
model AnnouncementAck {
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id])
  announcementId String
  acknowledgedAt DateTime @default(now())

  @@id([userId, announcementId])
}

model UserNotificationPreference {
  userId            String  @id @db.Uuid
  user              User    @relation(fields: [userId], references: [id])
  createTransaction Boolean @default(false)
  dailySummary      Boolean @default(false)
  subscriptionAudit Boolean @default(false)
  monthlyReport     Boolean @default(false)
}

model UserNotificationProvider {
  userId   String               @db.Uuid
  user     User                 @relation(fields: [userId], references: [id])
  provider NotificationProvider
  data     Json
  enabled  Boolean              @default(true)

  @@id([userId, provider])
}

model Transaction {
  id                     String                @id @default(uuid()) @db.Uuid
  description            String
  // The amount in the reporting currency (ILS) that every total sums.
  value                  Float
  // What was actually charged, in its own ISO 4217 currency; for an ILS row
  // the same amount as value.
  currency               String                @default("ILS") @db.Char(3)
  originalAmount         Decimal               @db.Decimal(14, 2)
  // How a foreign amount became value; all three are set exactly when
  // currency is not ILS (enforced by a CHECK constraint in the migration).
  exchangeRate           Decimal?              @db.Decimal(18, 8)
  exchangeRateDate       DateTime?             @db.Date
  exchangeRateSource     ExchangeRateSource?
  date                   DateTime
  categoryId             String                @db.Uuid
  category               Category              @relation(fields: [categoryId], references: [id])
  type                   TransactionType
  status                 TransactionStatus     @default(APPROVED)
  scheduledTransactionId String?               @db.Uuid
  scheduledTransaction   ScheduledTransaction? @relation(fields: [scheduledTransactionId], references: [id], onDelete: SetNull)
  userId                 String?               @db.Uuid
  user                   User?                 @relation(fields: [userId], references: [id])
  householdId            String                @db.Uuid
  household              Household             @relation(fields: [householdId], references: [id], onDelete: Restrict)
  // Who made the row and who last changed it; null for system writes and rows
  // older than attribution, whose creator was backfilled from userId.
  createdById            String?               @db.Uuid
  createdBy              User?                 @relation("TransactionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById            String?               @db.Uuid
  updatedBy              User?                 @relation("TransactionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdBySystem        Boolean               @default(false)
  importedTransactions   ImportedTransaction[]
  files                  TransactionFile[]

  @@index([householdId, status, date])
  @@index([categoryId])
  @@index([scheduledTransactionId])
}

model Import {
  id               String                @id @default(uuid()) @db.Uuid
  userId           String?               @db.Uuid
  fileUrl          String
  originalFileName String
  importType       ImportFileType?
  bankSourceType   ImportBankSourceType?
  status           ImportStatus          @default(PENDING)
  error            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  completedAt      DateTime?
  transactions     ImportedTransaction[]

  creditCardLastFourDigits String? /// encrypted by src/server/db/cardDigitsEncryption.ts
  paymentMonth             String? // Format: MM/YYYY
  deleted                  Boolean   @default(false)
  excelExtractionRequestId String?   @unique
  // Claimed by the first extraction callback, so a redelivery is a no-op.
  extractionCompletedAt    DateTime?
  // Set when this import duplicated an older one for the same card and month:
  // its rows moved there and this record stays as the pointer (status MERGED).
  mergedIntoImportId       String?   @db.Uuid
  mergedInto               Import?   @relation("ImportMerges", fields: [mergedIntoImportId], references: [id], onDelete: SetNull)
  mergedFrom               Import[]  @relation("ImportMerges")
  user                     User?     @relation(fields: [userId], references: [id])
  householdId              String    @db.Uuid
  household                Household @relation(fields: [householdId], references: [id], onDelete: Restrict)
  // Who made the row and who last changed it; null for system writes and rows
  // older than attribution, whose creator was backfilled from userId.
  createdById              String?   @db.Uuid
  createdBy                User?     @relation("ImportCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById              String?   @db.Uuid
  updatedBy                User?     @relation("ImportUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdBySystem          Boolean   @default(false)

  @@index([householdId, deleted, createdAt])
  @@index([mergedIntoImportId])
}

model ImportedTransaction {
  id                    String                    @id @default(uuid()) @db.Uuid
  importId              String                    @db.Uuid
  description           String
  // Null when the ILS amount is not known yet: a foreign charge the statement
  // did not bill and no rate covers, or a row whose currency is ambiguous.
  // Such a row cannot be approved until one is entered.
  value                 Float?
  // Null when the statement does not tell which currency the row is in.
  currency              String?                   @db.Char(3)
  originalAmount        Decimal                   @db.Decimal(14, 2)
  exchangeRate          Decimal?                  @db.Decimal(18, 8)
  exchangeRateDate      DateTime?                 @db.Date
  exchangeRateSource    ExchangeRateSource?
  date                  DateTime
  type                  TransactionType
  status                ImportedTransactionStatus @default(PENDING)
  matchingTransactionId String?                   @db.Uuid
  rawData               Json
  userId                String?                   @db.Uuid
  deleted               Boolean                   @default(false)
  import                Import                    @relation(fields: [importId], references: [id])
  user                  User?                     @relation(fields: [userId], references: [id])
  householdId           String                    @db.Uuid
  household             Household                 @relation(fields: [householdId], references: [id], onDelete: Restrict)
  // Who made the row and who last changed it; null for system writes and rows
  // older than attribution, whose creator was backfilled from userId.
  createdById           String?                   @db.Uuid
  createdBy             User?                     @relation("ImportedTransactionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById           String?                   @db.Uuid
  updatedBy             User?                     @relation("ImportedTransactionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdBySystem       Boolean                   @default(false)
  matchingTransaction   Transaction?              @relation(fields: [matchingTransactionId], references: [id])

  @@index([importId])
  @@index([householdId])
  @@index([matchingTransactionId])
}

model Category {
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String                 @unique
  parentId              String?                @db.Uuid
  parent                Category?              @relation("CategoryToCategory", fields: [parentId], references: [id])
  children              Category[]             @relation("CategoryToCategory")
  transactions          Transaction[]
  scheduledTransactions ScheduledTransaction[]
  autoApproveRules      AutoApproveRule[]
  categoryMappings      UserCategoryMapping[]
  detectedSubscriptions DetectedSubscription[]
}

model ScheduledTransaction {
  id                    String          @id @default(uuid()) @db.Uuid
  description           String
  value                 Float
  type                  TransactionType
  categoryId            String          @db.Uuid
  category              Category        @relation(fields: [categoryId], references: [id])
  scheduleType          ScheduleType
  interval              Int?
  dayOfWeek             Int?
  dayOfMonth            Int?
  monthOfYear           Int?
  // Set when the amount varies: imports match this schedule's pending rows by
  // this description prefix instead of by value.
  bankDescriptionPrefix String?
  lastRunDate           DateTime?
  nextRunDate           DateTime?
  userId                String?         @db.Uuid
  user                  User?           @relation(fields: [userId], references: [id])
  householdId           String          @db.Uuid
  household             Household       @relation(fields: [householdId], references: [id], onDelete: Restrict)
  // Who made the row and who last changed it; null for system writes and rows
  // older than attribution, whose creator was backfilled from userId.
  createdById           String?         @db.Uuid
  createdBy             User?           @relation("ScheduledTransactionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById           String?         @db.Uuid
  updatedBy             User?           @relation("ScheduledTransactionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdBySystem       Boolean         @default(false)
  transactions          Transaction[]

  // The cron scans nextRunDate across all households, so it cannot use the
  // householdId-prefixed index.
  @@index([nextRunDate])
  @@index([householdId, nextRunDate])
}

model TransactionFile {
  id            String                @id @default(uuid()) @db.Uuid
  transactionId String                @db.Uuid
  fileName      String
  fileKey       String
  fileSize      Int
  mimeType      String
  status        TransactionFileStatus @default(ACTIVE)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  transaction   Transaction           @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([status])
}

model UserCategoryMapping {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String?   @db.Uuid
  descriptionPattern String
  categoryId         String    @db.Uuid
  hitCount           Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User?     @relation(fields: [userId], references: [id])
  householdId        String    @db.Uuid
  household          Household @relation(fields: [householdId], references: [id], onDelete: Restrict)
  // Who made the row and who last changed it; null for system writes and rows
  // older than attribution, whose creator was backfilled from userId.
  createdById        String?   @db.Uuid
  createdBy          User?     @relation("UserCategoryMappingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById        String?   @db.Uuid
  updatedBy          User?     @relation("UserCategoryMappingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdBySystem    Boolean   @default(false)
  category           Category  @relation(fields: [categoryId], references: [id])

  @@unique([householdId, descriptionPattern])
}

enum ApiTokenScope {
  IMPORTS
  AGENT
}

model ApiToken {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String          @db.Uuid
  name       String
  tokenHash  String          @unique
  scopes     ApiTokenScope[]
  expiresAt  DateTime
  lastUsedAt DateTime?
  createdAt  DateTime        @default(now())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AutoApproveRule {
  id                 String          @id @default(uuid()) @db.Uuid
  userId             String?         @db.Uuid
  descriptionPattern String
  categoryId         String          @db.Uuid
  type               TransactionType
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  user               User?           @relation(fields: [userId], references: [id])
  householdId        String          @db.Uuid
  household          Household       @relation(fields: [householdId], references: [id], onDelete: Restrict)
  // Who made the row and who last changed it; null for system writes and rows
  // older than attribution, whose creator was backfilled from userId.
  createdById        String?         @db.Uuid
  createdBy          User?           @relation("AutoApproveRuleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById        String?         @db.Uuid
  updatedBy          User?           @relation("AutoApproveRuleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdBySystem    Boolean         @default(false)
  category           Category        @relation(fields: [categoryId], references: [id])

  @@index([householdId])
}

model DetectedSubscription {
  id                     String                @id @default(uuid()) @db.Uuid
  userId                 String?               @db.Uuid
  merchantName           String
  displayName            String
  averageAmount          Float
  frequency              SubscriptionFrequency
  lastChargeDate         DateTime
  nextExpectedDate       DateTime
  annualCost             Float
  status                 SubscriptionStatus    @default(DETECTED)
  matchingDescriptions   String[]
  scheduledTransactionId String?               @db.Uuid
  confidence             Float                 @default(0)
  categoryId             String?               @db.Uuid
  // Why the detector flagged this merchant: interval and amount statistics
  // plus the charges behind them, shaped by SubscriptionDetectionEvidence.
  detectionEvidence      Json?
  // Set once the user overrides the figures, so re-detection stops
  // overwriting displayName, averageAmount, frequency and categoryId.
  userEditedAt           DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  user            User?     @relation(fields: [userId], references: [id])
  householdId     String    @db.Uuid
  household       Household @relation(fields: [householdId], references: [id], onDelete: Restrict)
  // Who made the row and who last changed it; null for system writes and rows
  // older than attribution, whose creator was backfilled from userId.
  createdById     String?   @db.Uuid
  createdBy       User?     @relation("DetectedSubscriptionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById     String?   @db.Uuid
  updatedBy       User?     @relation("DetectedSubscriptionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdBySystem Boolean   @default(false)
  category        Category? @relation(fields: [categoryId], references: [id])

  // Frequency is part of the key but is user-editable, so detection resolves
  // an edited row by merchantName alone before falling back to this key.
  @@unique([householdId, merchantName, frequency])
  @@index([status])
  @@index([categoryId])
}

enum HouseholdActivityAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  MERGE
  IGNORE
  CONFIRM
  DISMISS
  INVITE_CREATED
  INVITE_REVOKED
  MEMBER_JOINED
  MEMBER_LEFT
  MEMBER_REMOVED
  ROLE_CHANGED
  API_TOKEN_REVOKED
}

enum HouseholdEntityType {
  TRANSACTION
  IMPORT
  IMPORTED_TRANSACTION
  SCHEDULED_TRANSACTION
  CATEGORY_MAPPING
  AUTO_APPROVE_RULE
  SUBSCRIPTION
  INVITE
  MEMBER
  API_TOKEN
  ATTACHMENT
}

// Append-only: who did what in a household, written in the same transaction
// as the change. A delete is traceable only here.
model HouseholdActivity {
  id           String                  @id @default(uuid()) @db.Uuid
  householdId  String                  @db.Uuid
  household    Household               @relation(fields: [householdId], references: [id], onDelete: Cascade)
  // Null for a system write, which names its job instead.
  actorUserId  String?                 @db.Uuid
  actorUser    User?                   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  // The API token the write came through (agent, script); not a foreign key,
  // so revoking the token keeps the record of what it did.
  actorTokenId String?                 @db.Uuid
  systemJob    String?
  action       HouseholdActivityAction
  entityType   HouseholdEntityType
  entityId     String
  // The entity's own words, shown untranslated; null when the action names nothing.
  summary      String?
  // The role an invite grants, a member joined with or was given.
  role         HouseholdRole?
  createdAt    DateTime                @default(now())

  @@index([householdId, createdAt(sort: Desc), id(sort: Desc)])
}
