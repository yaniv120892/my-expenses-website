datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  APPROVED
  PENDING_APPROVAL
}

enum NotificationProvider {
  TELEGRAM
}

enum ScheduleType {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REMATCHING
  MERGED
}

enum ImportFileType {
  VISA_CREDIT
  MASTERCARD_CREDIT
  AMERICAN_EXPRESS_CREDIT
}

enum ImportBankSourceType {
  NON_BANK_CREDIT
  BANK_CREDIT
}

enum SubscriptionStatus {
  DETECTED
  CONFIRMED
  DISMISSED
}

enum SubscriptionFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum ImportedTransactionStatus {
  PENDING
  APPROVED
  MERGED
  IGNORED
}

enum ExchangeRateSource {
  STATEMENT
  BANK_OF_ISRAEL
  MANUAL
}

enum TransactionFileStatus {
  ACTIVE
  MARKED_FOR_DELETION
  DELETED
}

model User {
  id                        String                @id @default(uuid()) @db.Uuid
  username                  String                @unique
  email                     String                @unique
  password                  String
  verified                  Boolean               @default(false)
  transactions              Transaction[]
  scheduledTransactions     ScheduledTransaction[]
  userNotification          UserNotificationPreference?
  userNotificationProviders UserNotificationProvider[]
  imports                   Import[]
  importedTransactions      ImportedTransaction[]
  autoApproveRules          AutoApproveRule[]
  categoryMappings          UserCategoryMapping[]
  detectedSubscriptions     DetectedSubscription[]
  announcementAcks          AnnouncementAck[]
  apiTokens                 ApiToken[]
}

// Which in-app announcements a user has acknowledged. announcementId is a
// string chosen in src/shared/announcements.ts rather than a foreign key, so
// retiring an announcement leaves a harmless orphan row instead of breaking.
model AnnouncementAck {
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id])
  announcementId String
  acknowledgedAt DateTime @default(now())

  @@id([userId, announcementId])
}

model UserNotificationPreference {
  userId             String   @id @db.Uuid
  user               User     @relation(fields: [userId], references: [id])
  createTransaction  Boolean  @default(false)
  dailySummary       Boolean  @default(false)
  subscriptionAudit  Boolean  @default(false)
  monthlyReport      Boolean  @default(false)
}

model UserNotificationProvider {
  userId    String              @db.Uuid
  user      User               @relation(fields: [userId], references: [id])
  provider  NotificationProvider
  data      Json
  enabled   Boolean            @default(true)

  @@id([userId, provider])
}

model Transaction {
  id                    String               @id @default(uuid()) @db.Uuid
  description           String
  // The amount in the reporting currency (ILS) that every total sums.
  value                Float
  // What was actually charged, in its own ISO 4217 currency; for an ILS row
  // the same amount as value.
  currency             String               @default("ILS") @db.Char(3)
  originalAmount       Decimal              @db.Decimal(14, 2)
  // How a foreign amount became value; all three are set exactly when
  // currency is not ILS (enforced by a CHECK constraint in the migration).
  exchangeRate         Decimal?             @db.Decimal(18, 8)
  exchangeRateDate     DateTime?            @db.Date
  exchangeRateSource   ExchangeRateSource?
  date                 DateTime
  categoryId           String               @db.Uuid
  category             Category             @relation(fields: [categoryId], references: [id])
  type                 TransactionType
  status               TransactionStatus    @default(APPROVED)
  scheduledTransactionId String?               @db.Uuid
  scheduledTransaction   ScheduledTransaction? @relation(fields: [scheduledTransactionId], references: [id], onDelete: SetNull)
  userId               String               @db.Uuid
  user                 User                 @relation(fields: [userId], references: [id])
  importedTransactions ImportedTransaction[]
  files                TransactionFile[]

  @@index([userId])
  @@index([categoryId])
  @@index([userId, status, date])
  @@index([scheduledTransactionId])
}

model Import {
  id            String               @id @default(uuid()) @db.Uuid
  userId        String               @db.Uuid
  fileUrl       String
  originalFileName String
  importType               ImportFileType?
  bankSourceType           ImportBankSourceType?
  status        ImportStatus         @default(PENDING)
  error         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  completedAt   DateTime?
  transactions  ImportedTransaction[]
  
  creditCardLastFourDigits String? /// encrypted by src/server/db/cardDigitsEncryption.ts
  paymentMonth             String? // Format: MM/YYYY
  deleted                  Boolean @default(false)
  excelExtractionRequestId String?   @unique
  // Claimed by the first extraction callback, so a redelivery is a no-op.
  extractionCompletedAt    DateTime?
  // Set when this import duplicated an older one for the same card and month:
  // its rows moved there and this record stays as the pointer (status MERGED).
  mergedIntoImportId       String?   @db.Uuid
  mergedInto               Import?   @relation("ImportMerges", fields: [mergedIntoImportId], references: [id], onDelete: SetNull)
  mergedFrom               Import[]  @relation("ImportMerges")
  user                     User      @relation(fields: [userId], references: [id])

  @@index([userId, deleted, createdAt])
  @@index([mergedIntoImportId])
}

model ImportedTransaction {
  id                    String                   @id @default(uuid()) @db.Uuid
  importId             String                   @db.Uuid
  description          String
  // Null when the ILS amount is not known yet: a foreign charge the statement
  // did not bill and no rate covers, or a row whose currency is ambiguous.
  // Such a row cannot be approved until one is entered.
  value                Float?
  // Null when the statement does not tell which currency the row is in.
  currency             String?                  @db.Char(3)
  originalAmount       Decimal                  @db.Decimal(14, 2)
  exchangeRate         Decimal?                 @db.Decimal(18, 8)
  exchangeRateDate     DateTime?                @db.Date
  exchangeRateSource   ExchangeRateSource?
  date                 DateTime
  type                 TransactionType
  status               ImportedTransactionStatus @default(PENDING)
  matchingTransactionId String?                 @db.Uuid
  rawData              Json
  userId               String                   @db.Uuid
  deleted              Boolean                  @default(false)
  import               Import                   @relation(fields: [importId], references: [id])
  user                 User                     @relation(fields: [userId], references: [id])
  matchingTransaction  Transaction?             @relation(fields: [matchingTransactionId], references: [id])

  @@index([importId])
  @@index([userId])
  @@index([matchingTransactionId])
}

model Category {
  id                    String                @id @default(uuid()) @db.Uuid
  name                  String                @unique
  parentId              String?              @db.Uuid
  parent                Category?            @relation("CategoryToCategory", fields: [parentId], references: [id])
  children              Category[]           @relation("CategoryToCategory")
  transactions          Transaction[]
  scheduledTransactions ScheduledTransaction[]
  autoApproveRules      AutoApproveRule[]
  categoryMappings      UserCategoryMapping[]
  detectedSubscriptions DetectedSubscription[]
}

model ScheduledTransaction {
  id            String          @id @default(uuid()) @db.Uuid
  description   String
  value         Float
  type          TransactionType
  categoryId    String          @db.Uuid
  category      Category        @relation(fields: [categoryId], references: [id])
  scheduleType  ScheduleType
  interval      Int?
  dayOfWeek     Int?
  dayOfMonth    Int?
  monthOfYear   Int?
  // Set when the amount varies: imports match this schedule's pending rows by
  // this description prefix instead of by value.
  bankDescriptionPrefix String?
  lastRunDate   DateTime?
  nextRunDate   DateTime?
  userId        String          @db.Uuid
  user          User            @relation(fields: [userId], references: [id])
  transactions  Transaction[]

  // The cron scans nextRunDate across all users, so it cannot use the
  // userId-prefixed index.
  @@index([nextRunDate])
  @@index([userId, nextRunDate])
}

model TransactionFile {
  id            String                @id @default(uuid()) @db.Uuid
  transactionId String                @db.Uuid
  fileName      String
  fileKey       String
  fileSize      Int
  mimeType      String
  status        TransactionFileStatus @default(ACTIVE)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  transaction   Transaction          @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([status])
}

model UserCategoryMapping {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @db.Uuid
  descriptionPattern String
  categoryId         String   @db.Uuid
  hitCount           Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id])
  category           Category @relation(fields: [categoryId], references: [id])

  @@unique([userId, descriptionPattern])
  @@index([userId])
}

enum ApiTokenScope {
  IMPORTS
}

model ApiToken {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String          @db.Uuid
  name       String
  tokenHash  String          @unique
  scopes     ApiTokenScope[]
  expiresAt  DateTime
  lastUsedAt DateTime?
  createdAt  DateTime        @default(now())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AutoApproveRule {
  id                 String          @id @default(uuid()) @db.Uuid
  userId             String          @db.Uuid
  descriptionPattern String
  categoryId         String          @db.Uuid
  type               TransactionType
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  user               User            @relation(fields: [userId], references: [id])
  category           Category        @relation(fields: [categoryId], references: [id])

  @@index([userId])
}

model DetectedSubscription {
  id                     String                @id @default(uuid()) @db.Uuid
  userId                 String                @db.Uuid
  merchantName           String
  displayName            String
  averageAmount          Float
  frequency              SubscriptionFrequency
  lastChargeDate         DateTime
  nextExpectedDate       DateTime
  annualCost             Float
  status                 SubscriptionStatus    @default(DETECTED)
  matchingDescriptions   String[]
  scheduledTransactionId String?               @db.Uuid
  confidence             Float                 @default(0)
  categoryId             String?               @db.Uuid
  // Why the detector flagged this merchant: interval and amount statistics
  // plus the charges behind them, shaped by SubscriptionDetectionEvidence.
  detectionEvidence      Json?
  // Set once the user overrides the figures, so re-detection stops
  // overwriting displayName, averageAmount, frequency and categoryId.
  userEditedAt           DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  user                   User                  @relation(fields: [userId], references: [id])
  category               Category?             @relation(fields: [categoryId], references: [id])

  // Frequency is part of the key but is user-editable, so detection resolves
  // an edited row by merchantName alone before falling back to this key.
  @@unique([userId, merchantName, frequency])
  @@index([userId])
  @@index([status])
  @@index([categoryId])
}
